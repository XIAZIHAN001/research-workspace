{
  "name": "research-workspace",
  "version": "0.13.2",
  "private": true,
  "type": "module",
  "description": "Local-first research paper reading workspace (Phase 0 prototype)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "ai:serve": "node server/start.mjs",
    "ai:serve:offline": "node server/start.mjs --offline",
    "ai:serve:online": "node server/start.mjs --online",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify/run.mjs",
    "verify:reader": "node scripts/verify/reader.mjs",
    "verify:compat": "node scripts/verify/compat.mjs",
    "verify:annotations": "node scripts/verify/annotations.mjs",
    "verify:ai": "node scripts/verify/ai-reading.mjs",
    "verify:immersive": "node scripts/verify/immersive.mjs",
    "verify:guard": "node scripts/verify/guard-probe.mjs",
    "verify:graph": "node scripts/verify/graph.mjs",
    "verify:backup": "node scripts/verify/backup.mjs",
    "verify:research-workflow": "node scripts/verify/research-workflow.mjs",
    "verify:knowledge-real": "node scripts/verify/real-knowledge.mjs",
    "verify:knowledge-ai": "node scripts/verify/knowledge-ai.mjs",
    "verify:knowledge-replay": "node scripts/verify/knowledge-replay.mjs",
    "verify:knowledge-replay-all": "node scripts/verify/replay-all.mjs",
    "verify:real": "node scripts/verify/real-paper.mjs",
    "verify:live": "node scripts/verify/live-api.mjs",
    "verify:desktop": "node scripts/verify/desktop.mjs",
    "verify:desktop-dev": "node scripts/verify/desktop-dev.mjs",
    "verify:desktop-phase11": "node scripts/verify/desktop-phase11.mjs",
    "verify:desktop-online-sim": "node scripts/verify/desktop-online-sim.mjs",
    "verify:desktop-isolated": "node scripts/verify/desktop-isolated.mjs",
    "verify:ui-phase12": "node scripts/verify/ui-phase12.mjs",
    "verify:ui-phase12-desktop": "node scripts/verify/ui-phase12-desktop.mjs",
    "verify:cleanup-list": "node scripts/verify/cleanup-inventory.mjs",
    "verify:export-backup": "node scripts/verify/export-backup.mjs",
    "desktop:prepare": "node scripts/desktop/prepare-sidecar.mjs",
    "desktop:dev": "npm run desktop:prepare && tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "npm run desktop:prepare && tauri build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "katex": "0.19.0",
    "lucide-react": "1.57.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
